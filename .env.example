# Connessione al Postgres locale avviato con `npm run db:up`
DATABASE_URL=postgres://postgres:postgres@localhost:5433/amazing_mandala
# Stringa casuale lunga: genera la tua, non riusare questa
PAYLOAD_SECRET=cambia-questo-valore

# Indirizzo pubblico del sito (in locale: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe, modalità test: dashboard.stripe.com → Sviluppatori → Chiavi API
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Segreto del webhook: in locale lo stampa `stripe listen` (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_...
